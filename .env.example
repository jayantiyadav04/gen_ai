# ==============================================================================
# CampusVision AI - Environment Configuration Template
# ==============================================================================
# Default setup: FREE local generation with ComfyUI Desktop (Stable Diffusion 1.5 + ControlNet Canny).
#   1. Open ComfyUI Desktop and keep it running.
#   2. Copy this file to .env:  cp .env.example .env
#   3. Start the backend. No API key is needed.
# ==============================================================================

# Generation engine: 'comfyui' (local, free) | 'replicate' | 'huggingface' | 'fal' | 'demo' | 'auto'
DEFAULT_PROVIDER=comfyui

# Local ComfyUI server (check the port in your ComfyUI Desktop; 8188 is the usual one)
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_CHECKPOINT=v1-5-pruned-emaonly.safetensors
COMFYUI_CONTROLNET=control_v11p_sd15_canny_fp16.safetensors
# Seconds to wait for one local render (first run is slower while models load)
COMFYUI_TIMEOUT=900

# Optional cloud providers (only needed if you switch the engine above)
REPLICATE_API_TOKEN=
REPLICATE_POLL_TIMEOUT=120
HUGGINGFACE_API_KEY=
FAL_KEY=
