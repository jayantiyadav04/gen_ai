# ==============================================================================
# CampusVision AI — Environment Configuration Template
# ==============================================================================
# To activate live cloud GPU diffusion rendering:
# 1. Copy this file to .env:  cp .env.example .env
# 2. Get your free Replicate API token at: https://replicate.com/account/api-tokens
# 3. Paste your token below and restart the server.
# ==============================================================================

# Primary Cloud AI Provider: 'replicate' | 'huggingface' | 'fal' | 'demo'
DEFAULT_PROVIDER=replicate

# Replicate API Token (Primary image-to-image ControlNet Canny provider)
# Model: lucataco/sdxl-controlnet
REPLICATE_API_TOKEN=r8_your_replicate_api_token_here

# Optional: Replicate Polling Timeout in seconds (default: 120)
REPLICATE_POLL_TIMEOUT=120

# Optional Secondary Providers
HUGGINGFACE_API_KEY=
FAL_KEY=

